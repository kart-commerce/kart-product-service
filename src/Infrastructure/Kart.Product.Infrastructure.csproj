<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Kart.Product.Application.csproj" />
    <ProjectReference Include="..\Domain\Kart.Product.Domain.csproj" />
  </ItemGroup>

  <!-- PostgreSQL write side (database-design.md): product_groups, variants, product_outbox_events. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
  </ItemGroup>

  <!-- MongoDB read side (database-design.md): product_read_model, sharded on category.id. -->
  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />
  </ItemGroup>

  <!-- Message-bus-manifest-driven RabbitMQ topology (mirrors kart-identity-service's proven pattern). -->
  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />
    <!-- Vendored via packages/ (../../nuget.config), same pattern as kart-admin-service/etc. -->
    <PackageReference Include="Kart.Shared.Messaging" Version="0.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for IHttpContextAccessor (HttpCurrentPrincipal) and BackgroundService (OutboxRelayHostedService, RabbitMqTopologyStartupHostedService, CatalogProjectionConsumerHostedService, ReviewEventsConsumerHostedService). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    contracts/message-bus-manifest.json is this service's single source of truth for its RabbitMQ
    topology - copied into the Api project's output directory (see Api.csproj) so
    RabbitMqOptions.ManifestPath (resolved against AppContext.BaseDirectory) finds it at runtime.
  -->

</Project>
