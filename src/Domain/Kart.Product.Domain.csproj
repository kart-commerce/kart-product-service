<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Kart.Shared.Domain (kart-conventions.md) supplies AggregateRoot (Guid-keyed, fits
    ProductGroup) and IDomainEvent - the "one platform-wide implementation, not built locally
    by each service" pattern. Vendored via packages/ (../../nuget.config), same pattern as
    kart-admin-service/kart-category-service/kart-offer-service/etc. Variant is keyed by its own
    string Sku (not a Guid), so it does not use AggregateRoot - see Variants/Variant.cs.
  -->
  <ItemGroup>
    <PackageReference Include="Kart.Shared.Domain" Version="0.1.0" />
  </ItemGroup>

</Project>
