<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Kart.Shared.Domain (kart-conventions.md) supplies AggregateRoot (Guid-keyed, fits
    ProductGroup) and IDomainEvent - the "one platform-wide implementation, not built locally
    by each service" pattern. No published NuGet feed exists yet, so this is a ProjectReference
    (kart-shared's own README documents this as the interim consumption path). Variant is keyed
    by its own string Sku (not a Guid), so it does not use AggregateRoot - see Variants/Variant.cs.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\kart-shared\src\Kart.Shared.Domain\Kart.Shared.Domain.csproj" />
  </ItemGroup>

</Project>
