# Copy to .env (gitignored) and fill in real values for your machine.
# scripts/migrate.sh loads this automatically — only needed if your local Postgres differs from
# ProductDbContextFactory's localhost/kart_product_service default. Value below points at
# kart-devops's shared docker-compose stack (../kart-devops/scripts/dev-up.sh), whose Postgres
# host port and superuser credentials are the canonical local-dev target
# (kart-devops/ports.env: POSTGRES_PORT=5433; kart-devops/compose/postgres-init/01-create-databases.sql).
# Keep the quotes: migrate.sh sources this file with bash, and an unquoted ";"
# in the connection string is parsed as a command separator, silently truncating it.
PRODUCT_DB_CONNECTION_STRING="Host=localhost;Port=5433;Database=kart_product;Username=postgres;Password=postgres"
